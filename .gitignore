# Bank statements and any real financial document. Never commit these.
.examples/
statements/
*.pdf
*.csv

# The local database, and every file SQLite or a backup puts beside it:
# finance.db-wal and finance.db-journal are the database mid-write, and a
# copy named finance.db.backup is still every transaction you have.
*.db
*.db-*
*.db.*
*.sqlite*

# Python
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Design docs stay out of the repo (CLAUDE.md)
DESIGN.md

# Exported financial data, regenerated by serve.py. The .<pid>.tmp is an
# export being written.
frontend/data.json
frontend/data.json.*

# Merchant review list (contains merchant names from your statements)
CATEGORY-REVIEW.md
