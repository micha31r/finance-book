# Bank statements & any real financial documents — never commit
.examples/
statements/
*.pdf

# Local database. The trailing * matters: a copy named finance.db.backup is
# still every transaction you have, and *.db alone does not match it.
*.db
*.db.*
*.db-journal
*.sqlite
*.sqlite*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# Design docs (untracked by project convention)
DESIGN.md

# working database
finance.db

# exported financial data, regenerated by serve.py
frontend/data.json
frontend/data.json.*

# merchant review list (contains merchant names from your statements)
CATEGORY-REVIEW.md
